{
  "name": "prompt-forge-vscode",
  "displayName": "Prompt Forge",
  "description": "Transform messy notes into model-optimized prompts with RAG-powered intelligence. Supports Claude, GPT-4, Gemini, and more.",
  "version": "0.6.0",
  "icon": "icon.png",
  "publisher": "BecherZribi",
  "repository": {
    "type": "git",
    "url": "https://huggingface.co/spaces/Becher-zribi/prompt-forge-rag"
  },
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:promptForge.open",
    "onCommand:promptForge.stop"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "promptForge.open",
        "title": "Prompt Forge: Open App"
      },
      {
        "command": "promptForge.stop",
        "title": "Prompt Forge: Stop App"
      }
    ],
    "configuration": {
      "title": "Prompt Forge",
      "properties": {
        "promptForge.mode": {
          "type": "string",
          "enum": ["cloud", "local"],
          "default": "cloud",
          "description": "Whether to use the Hugging Face Cloud version or a local Python server."
        },
        "promptForge.hfUrl": {
          "type": "string",
          "default": "https://huggingface.co/spaces/Becher-zribi/prompt-forge-rag",
          "description": "The URL of your Hugging Face Space (if mode is set to cloud)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -p ./ --watch",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.88.0",
    "@vscode/vsce": "^2.29.0",
    "typescript": "^5.6.0"
  }
}
